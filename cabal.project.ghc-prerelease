-- Overlay for building against GHC pre-releases. CI uses it by linking it as
-- cabal.project.local. To use it locally, do the same:
--
--   ln -s cabal.project.ghc-prerelease cabal.project.local
--
-- Remove workarounds from this file as dependencies catch up, and remove the
-- file itself once there is no pre-release GHC being tested.

-- Released dependencies supporting new GHCs usually postdate the index-state
-- pinned in cabal.project.
index-state: HEAD

-- https://github.com/clash-lang/ghc-typelits-knownnat/pull/75
source-repository-package
  type: git
  location: https://github.com/clash-lang/ghc-typelits-knownnat.git
  tag: 4f041a82edad86e4a8ff8db057922bfe66a272a8

-- https://github.com/clash-lang/ghc-typelits-extra/pull/79
source-repository-package
  type: git
  location: https://github.com/rowanG077/ghc-typelits-extra.git
  tag: ec4e9efd31c66c5f027cdb4322462194ef4a3bf0

allow-newer:
  -- ghc-typelits-extra's GHC 10 branch still caps ghc-tcplugin-api at <0.20,
  -- but ghc-typelits-natnormalise-0.9.7 and the knownnat branch need 0.20.
  ghc-typelits-extra:ghc-tcplugin-api,
  -- template-haskell bounds lag behind every new GHC release
  *:template-haskell,

-- string-interpolate 1.0 switched to ghc-hs-meta, which doesn't support GHC 10
constraints:
  string-interpolate <1
